local get_scriptnames = function()
  vim.cmd([[
    let scriptnames_output = ''
    redir => scriptnames_output
      silent scriptnames
    redir END

    let scripts = {}
    for line in split(scriptnames_output, "\n")
      if line =~ '\S'
      let nr = matchstr(line, '\d\+')
      let name = substitute(line, '.\+:\s*', '', '')
      let scripts[nr] = name
      endif
    endfor
    w:scriptnames_output = scriptnames_output
    " unlet scriptnames_output
  ]])
  local scriptnames = vim.api.nvim_eval("w:scriptnames_output")
  return scriptnames
end

local get_paths = function(cmd_props)
  local all_paths = {}
  all_paths.rtpaths = get_runtime_files()
  local opacks = {}
  for match in (vim.o.packpath .. ","):gmatch("(.-)" .. ",") do
    table.insert(opacks, match)
  end
  all_paths.opacks = vim.fn.sort(opacks)
  all_paths.scriptnames = get_scriptnames()

  vim.dbglog(all_paths)

  vim.ui.select(opacks)
end

get_paths()
