#!/usr/bin/python3
"""Benchmark startup and rendering of this Neovim config; record and tabulate the results.

  benchmarks/run                          measure and print the table; record nothing
  benchmarks/run --release 0.16.0         record a release (scripts/push.sh does this): counts and
                                          sizes always, times only from a quiet machine
  benchmarks/run --baseline               record a new baseline: waits for a low load,
                                          more sessions; rerun by hand now and then

See benchmarks/README.md.
"""

import argparse
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import bench  # noqa: E402

CPUS = os.cpu_count() or 1


def log(message):
  print(f"bench: {message}", file=sys.stderr, flush=True)


def main():
  parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
  mode = parser.add_mutually_exclusive_group()
  mode.add_argument("--release", metavar="VERSION", help="record the results as this release")
  mode.add_argument("--baseline", action="store_true", help="record a new baseline under low load")
  parser.add_argument("--runs", type=int, help="measured sessions (default 3, baseline 10)")
  parser.add_argument("--no-wait", action="store_true", help="skip the load gate of an adhoc run or baseline")
  args = parser.parse_args()

  runs = args.runs or (10 if args.baseline else 3)
  if not args.release and not args.no_wait:
    # Baselines need a quiet machine; adhoc runs wait a while, then go ahead and say so.
    limit, max_wait = (0.15 * CPUS, 1800) if args.baseline else (0.6 * CPUS, 600)
    if not bench.wait_for_load(limit, max_wait, log=log):
      if args.baseline:
        log(f"load stayed above {limit:.2f} for {max_wait // 60} min; no baseline recorded")
        return 1
      log(f"load still above {limit:.2f}; measuring anyway (see the load in the table)")

  kind = "baseline" if args.baseline else "release" if args.release else "adhoc"
  version = args.release or bench.git("describe", "--tags", "--abbrev=0").lstrip("v") + "+dev"
  meta = bench.metadata(kind, version)
  if args.release:
    measured = bench.measure_release(runs, log=log)
  else:
    try:
      measured = bench.measure(runs, log=log)
    except bench.BenchError as error:
      log(f"failed: {error}")
      return 1

  counts = {name: measured.pop(name)[0] for name in ("plugins installed", "plugins loaded") if name in measured}
  if kind != "adhoc":
    counts.update(bench.collect_code_counts(log=log))
    counts["config size"] = bench.config_size_mib()
    counts["plugin size"] = bench.plugin_size_mib()

  rows = bench.to_rows(meta, measured, counts, runs)
  history = bench.read_history()
  # Compared before recording: a release against earlier releases, a baseline against the last one.
  table, warnings = bench.table_for(history, rows, runs)

  if kind != "adhoc":
    history = bench.record(history, rows)
    bench.write_history(history)
    log(f"recorded {kind} {version} in {bench.HISTORY.relative_to(bench.ROOT)}")
    bench.update_performance_doc(bench.trend_table(history))
  print(table)
  for warning in warnings:
    log(f"warning: {warning}")
  return 0


if __name__ == "__main__":
  sys.exit(main())
