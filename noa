local cmp_helper =
{
  -- Deprioritize items starting with underscores (private or protected)
  deprioritize_underscore = function(
      lhs,
      rhs
  )
    local l = (
      lhs.completion_item.label:find(
        "^_+"
      )
      )
      and 1
      or 0
    local r = (
      rhs.completion_item.label:find(
        "^_+"
      )
      )
      and 1
      or 0
    if l
      ~= r
    then
      return l
        < r
    end
  end,
  -- Prioritize items that ends with "= ..." (usually for argument completion).
  prioritize_argument = function(
      lhs,
      rhs
  )
    local l = (
      lhs.completion_item.label:find(
        "=$"
      )
      )
      and 1
      or 0
    local r = (
      rhs.completion_item.label:find(
        "=$"
      )
      )
      and 1
      or 0
    if l
      ~= r
    then
      return l
        > r
    end
  end,
}

