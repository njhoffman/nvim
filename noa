local has_words_before =
function(
    cmdline
)
  local line, col =
  unpack(
    vim.api.nvim_win_get_cursor(
      0
    )
  )
  if cmdline
  then
    col = col
      + 1
  end
  return col
    ~= 0
    and vim.api
    .nvim_buf_get_lines(
      0,
      line
      - 1,
      line,
      true
    )[1]
    :sub(
      col,
      col
    )
    :match(
      "%s"
    )
    == nil
end

