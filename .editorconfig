[*]
trim_trailing_whitespace = true
insert_final_newline     = true
charset                  = utf-8
max_line_length          = 120
indent_style             = space
tab_width                = 2
indent_size              = 2


[{*.lua,*.tl,}]
indent_style             = space
indent_size              = 2

[*.lua]
quote_style              = double
trailing_table_separator = smart
call_arg_parentheses     = keep
align_call_args          = true
align_function_params    = true

[*.{bash,sh}]
indent_style       = space
indent_size        = 2
charset            = utf-8
shell_variant      = bash
binary_next_line   = false
switch_case_indent = true
space_redirects    = false
keep_padding       = true
function_next_line = false

[*.vim]
indent_style = space
tab_width = 2
indent_size = 2
