                            			let l:dwpos = getpos('.')
                            			" need to make range inclusive
                            			call setpos('.', l:pos)
                            			normal! v
                            			call setpos('.', l:dwpos)
                            		endif
                            	endif
                            
                            	" ugly hack for 'w' going forwards at end of file
                            	" and 'ge' going backwards at beginning of file
