{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "spidercode",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "spidercode_block"
        },
        {
          "type": "SYMBOL",
          "name": "text_content"
        }
      ]
    },
    "spidercode_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag_open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "code_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "tag_close"
        }
      ]
    },
    "tag_open": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "%spidercode%"
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "tag_close": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "%spidercode%"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\n"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "code_content"
    },
    {
      "type": "SYMBOL",
      "name": "text_content"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}